# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Gemini ──────────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Pinecone ─────────────────────────────────────────────────────────────────
# Get your key from https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here

# Index name (created automatically on first ingest)
PINECONE_INDEX_NAME=genshin-assistant

# Serverless region — free tier defaults
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Redis ────────────────────────────────────────────────────────────────────
# Default points to local Docker container (docker compose up -d)
REDIS_URL=redis://localhost:6379

# Answer cache TTL in seconds (default 24 h)
# Invalidated by POST /cache/{character} after a re-ingest
REDIS_TTL=86400
